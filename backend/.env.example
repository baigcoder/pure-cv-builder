# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string (Connect -> Transaction pooler, port 6543).
# Defaults to a local SQLite file when unset.
DATABASE_URL=

# Supabase project URL and anon/publishable key. Used to verify sign-in tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: legacy JWT secret to verify HS256 tokens locally instead of
# asking the Supabase auth server. Do NOT put the service_role key anywhere.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:3000
OPENCODE_API_KEY=
